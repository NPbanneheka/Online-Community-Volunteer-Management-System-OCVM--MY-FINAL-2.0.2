@* 
View responsibility: Views/Dashboard/Index.cshtml
Technology map:
- Razor syntax mixes HTML with C# expressions for dynamic page rendering.
- Tag Helpers such as asp-action/asp-controller connect forms and links to MVC controller actions.
- Model/ViewBag data comes from the controller action that returns this view.
*@

@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var myProfile = ViewBag.MyProfile as UserProfile;
    var upcoming = ViewBag.UpcomingEvents as List<VolunteerEvent> ?? new();
    var posts = ViewBag.RecentPosts as List<CommunityPost> ?? new();
    string ratingTitle = ViewBag.RatingTitle as string ?? "Average Rating";
    string ratingEmptyText = ViewBag.RatingEmptyText as string ?? "No ratings yet";
}

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card card-modern p-4 dashboard-banner">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <h2 class="fw-bold mb-1">Hello @(myProfile?.FullName ?? User.Identity?.Name)</h2>
                    <p class="text-muted mb-0">Welcome to your modern volunteer dashboard.</p>
                </div>
                <a class="btn btn-gradient rounded-pill px-4" asp-controller="Events" asp-action="Index">Explore Events</a>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card card-modern p-4 h-100">
            <div class="d-flex align-items-center gap-3">
                @* Conditional UI: shows/hides content based on role, status, or available data. *@
@if (!string.IsNullOrWhiteSpace(myProfile?.ProfileImageUrl))
                {
                    <img src="@myProfile.ProfileImageUrl" class="rounded-circle shadow-sm" style="width:70px;height:70px;object-fit:cover;object-position:center;" alt="Profile" />
                }
                else
                {
                    <div class="avatar-lg">@((myProfile?.FullName ?? "U").Substring(0,1).ToUpper())</div>
                }
                <div>
                    <div class="fw-semibold">@(myProfile?.RoleName ?? "User")</div>
                    <small class="text-muted d-block">@(myProfile?.PublicEmail ?? User.Identity?.Name)</small>
                    @if (myProfile?.IsVerified == true)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill"><i class="bi bi-patch-check-fill me-1"></i> Verified</span>
                    }
                    else
                    {
                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill"><i class="bi bi-hourglass-split me-1"></i> Pending Verification</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3"><div class="card stat-card p-4"><div class="stat-number text-primary">@Model.ActiveEvents</div><div class="text-muted">Active Events</div><small class="text-muted">Total: @Model.TotalEvents</small></div></div>
    <div class="col-md-3"><div class="card stat-card p-4"><div class="stat-number text-success">@Model.MyRegistrations</div><div class="text-muted">My Registrations</div></div></div>
    <div class="col-md-3"><div class="card stat-card p-4"><div class="stat-number text-info">@Model.CommunityPosts</div><div class="text-muted">Community Posts</div><small class="text-muted">Help: @Model.CommunityHelpPosts</small></div></div>
    <div class="col-md-3">
        <div class="card stat-card p-4">
            @if (Model.RatingCount > 0)
            {
                <div class="stat-number text-warning">@Model.AverageRating.ToString("0.0")</div>
                <div class="text-muted">@ratingTitle</div>
                <small class="text-muted">Based on @Model.RatingCount rating(s)</small>
            }
            else
            {
                <div class="stat-number text-muted">N/A</div>
                <div class="text-muted">@ratingTitle</div>
                <small class="text-muted">@ratingEmptyText</small>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card card-modern p-4 h-100">
            <h5 class="fw-bold mb-3">Upcoming Events</h5>
            @if (!upcoming.Any())
            {
                <p class="text-muted mb-0">No upcoming active events available.</p>
            }
            @* Loop: repeats this UI block for each item sent by the controller. *@
@foreach (var item in upcoming)
            {
                <div class="d-flex justify-content-between align-items-center border-bottom py-2 gap-3">
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="rounded-3" style="width:54px;height:42px;object-fit:cover;" alt="Event" />
                        }
                        <div>
                            <div class="fw-semibold">@item.Title</div>
                            <small class="text-muted">@item.EventDate.ToString("dd MMM yyyy") · @item.Location</small>
                        </div>
                    </div>
                    <a class="btn btn-sm btn-outline-primary rounded-pill" asp-controller="Events" asp-action="Details" asp-route-id="@item.Id">Open</a>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card card-modern p-4 h-100">
            <h5 class="fw-bold mb-3">Recent Community Posts</h5>
            @if (!posts.Any())
            {
                <p class="text-muted mb-0">No community posts yet.</p>
            }
            @foreach (var item in posts)
            {
                <div class="border-bottom py-2">
                    <div class="d-flex justify-content-between">
                        <div class="fw-semibold">@item.Title</div>
                        <span class="badge @(item.PostType == "Help" ? "bg-danger" : "bg-primary") bg-opacity-10 @(item.PostType == "Help" ? "text-danger" : "text-primary") rounded-pill">@(item.PostType == "Help" ? "Community Help" : "Post")</span>
                    </div>
                    <small class="text-muted">@item.Content</small>
                </div>
            }
        </div>
    </div>
</div>
