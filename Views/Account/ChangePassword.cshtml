@* Views/Account/ChangePassword.cshtml: Razor view that renders the Account/ChangePassword page in the browser. Comments describe UI/data purpose only. *@
@* @model declares the C# type this Razor page receives from its controller. *@
@model OCVMS.ViewModels.ChangePasswordViewModel
@* Razor code block prepares page variables such as title, filters, or values from ViewBag/ViewData. *@
@{
    ViewData["Title"] = "Change Password";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-shield-lock-fill text-primary" style="font-size: 3rem;"></i>
                    <h2 class="fw-bold mt-2 mb-1">Change Password</h2>
                    <p class="text-muted mb-0">Update your account password securely.</p>
                </div>

                @* Form sends user input back to a controller action for validation and processing. *@
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-bold"></label>
                        @* asp-for binds this input to a ViewModel or Model property. *@
                        <input asp-for="CurrentPassword" class="form-control rounded-3" />
                        @* Displays server/client validation messages for the connected input property. *@
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-bold"></label>
                        @* asp-for binds this input to a ViewModel or Model property. *@
                        <input asp-for="NewPassword" class="form-control rounded-3" />
                        @* Displays server/client validation messages for the connected input property. *@
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <small class="text-muted">Use at least 6 characters.</small>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                        @* asp-for binds this input to a ViewModel or Model property. *@
                        <input asp-for="ConfirmPassword" class="form-control rounded-3" />
                        @* Displays server/client validation messages for the connected input property. *@
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                            <i class="bi bi-check-circle me-1"></i> Update Password
                        </button>
                        @* Tag Helpers generate correct MVC URLs for controller actions. *@
                        <a asp-controller="Profile" asp-action="MyProfile" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
