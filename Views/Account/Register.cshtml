@* 
View responsibility: Views/Account/Register.cshtml
Technology map:
- Razor syntax mixes HTML with C# expressions for dynamic page rendering.
- Tag Helpers such as asp-action/asp-controller connect forms and links to MVC controller actions.
- Model/ViewBag data comes from the controller action that returns this view.
*@

@model RegisterViewModel
@{ ViewData["Title"] = "Register"; }

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-lg border-0 rounded-4 p-4 p-lg-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-primary">Create Your Account</h2>
                    <p class="text-muted">Join OCVMS to start volunteering today.</p>
                </div>

                @* Form area: collects user input and sends it to the controller action. *@
<form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-medium">Full Name</label>
                        @* Input field: binds form data to the model/view model. *@
<input asp-for="FullName" class="form-control rounded-pill px-3" placeholder="Enter your full name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-medium">Email Address</label>
                        <input asp-for="Email" class="form-control rounded-pill px-3" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-medium">Password</label>
                            <input asp-for="Password" class="form-control rounded-pill px-3" type="password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-medium">Confirm Password</label>
                            <input asp-for="ConfirmPassword" class="form-control rounded-pill px-3" type="password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RoleName" class="form-label fw-medium text-primary">Register As</label>
                        <select asp-for="RoleName" id="roleSelect" class="form-select rounded-pill px-3 border-primary">
                            <option value="Volunteer">Volunteer (I want to help)</option>
                            <option value="Organizer">Organizer (I want to host events)</option>
                        </select>
                        <small class="text-muted d-block mt-1">Organizer accounts must provide their organization name for secure access control.</small>
                        <span asp-validation-for="RoleName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4" id="organizationBox">
                        <label asp-for="OrganizationName" class="form-label fw-medium">Organization Name</label>
                        <input asp-for="OrganizationName" class="form-control rounded-pill px-3" placeholder="Enter your organization name" />
                        <small class="text-muted d-block mt-1">Use the same spelling for all organizers in the same organization.</small>
                        <span asp-validation-for="OrganizationName" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm">
                        <i class="bi bi-person-plus-fill me-2"></i> Create Account
                    </button>

                    <div class="text-center mt-4">
                        <span class="text-muted">Already have an account?</span>
                        <a asp-action="Login" class="text-decoration-none fw-bold text-primary ms-1">Login Here</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { 
    <partial name="_ValidationScriptsPartial" /> 
    <script>
        function toggleOrganizationBox() {
            const roleSelect = document.getElementById('roleSelect');
            const organizationBox = document.getElementById('organizationBox');
            const organizationInput = document.getElementById('OrganizationName');

            if (roleSelect.value === 'Organizer') {
                organizationBox.style.display = 'block';
                organizationInput.setAttribute('required', 'required');
            } else {
                organizationBox.style.display = 'none';
                organizationInput.removeAttribute('required');
            }
        }

        document.getElementById('roleSelect').addEventListener('change', toggleOrganizationBox);
        toggleOrganizationBox();
    </script>
}
