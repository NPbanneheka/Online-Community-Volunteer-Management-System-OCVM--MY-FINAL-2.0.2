@* ================================================================
   VIVA COMMENTED VERSION - Views/Account/Login.cshtml
   Purpose: Razor View file: builds the HTML page shown to the user and displays data supplied by the controller.
   Note: Razor comments do not display to users; they help you explain the page in viva.
   ================================================================ *@

@model LoginViewModel
@{ ViewData["Title"] = "Login"; }

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card card-modern p-4 p-lg-5">
            <h2 class="fw-bold mb-4">Welcome back</h2>
            @* Form area: collects user input and sends it to the controller action. *@
<form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    @* Input field: binds form data to the model/view model. *@
<input asp-for="Email" class="form-control form-control-modern" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control form-control-modern" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                
                <div class="alert alert-light border small mb-4">
                    <i class="bi bi-shield-lock me-1 text-primary"></i>
                    For security, your login session will not be saved after the browser session expires.
                </div>
                
                <button class="btn btn-gradient w-100 rounded-pill py-2">Login</button>
            </form>
        </div>
    </div>
</div>

@section Scripts { 
    <partial name="_ValidationScriptsPartial" /> 
}