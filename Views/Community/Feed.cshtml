@* ================================================================
   VIVA COMMENTED VERSION - Views/Community/Feed.cshtml
   Purpose: Razor View file: builds the HTML page shown to the user and displays data supplied by the controller.
   Note: Razor comments do not display to users; they help you explain the page in viva.
   ================================================================ *@

@model IEnumerable<OCVMS.Models.CommunityPost>
@using System.Runtime.InteropServices
@{
    ViewData["Title"] = "Community Hub";
    var currentProfile = ViewBag.CurrentProfile as UserProfile;
    var postCount = ViewBag.PostCount ?? 0;
    var totalPostCount = ViewBag.TotalPostCount ?? 0;
    var helpPostCount = ViewBag.HelpPostCount ?? 0;
    var myHelpPostCount = ViewBag.MyHelpPostCount ?? 0;
    var filter = (string)(ViewBag.Filter ?? "All");
    var sortOrder = (string)(ViewBag.SortOrder ?? "Newest");
    var manageablePostIds = ViewBag.ManageablePostIds as List<int> ?? new List<int>();
    var manageableCommentIds = ViewBag.ManageableCommentIds as List<int> ?? new List<int>();
}

@functions {
    private DateTime ToSriLankaTime(DateTime value)
    {
        if (value == DateTime.MinValue) return value;

        var utcValue = value.Kind == DateTimeKind.Utc
            ? value
            : DateTime.SpecifyKind(value, DateTimeKind.Utc);

        var timeZoneId = RuntimeInformation.IsOSPlatform(OSPlatform.Windows)
            ? "Sri Lanka Standard Time"
            : "Asia/Colombo";

        var sriLankaTimeZone = TimeZoneInfo.FindSystemTimeZoneById(timeZoneId);
        return TimeZoneInfo.ConvertTimeFromUtc(utcValue, sriLankaTimeZone);
    }
}

<div class="container py-4">
    @* Conditional UI: shows/hides content based on role, status, or available data. *@
@if (TempData["Error"] != null) { <div class="alert alert-danger border-0 shadow-sm rounded-pill"><i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]</div> }

    <div class="row g-4">
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 sticky-top" style="top: 90px;">
                @if (!string.IsNullOrWhiteSpace(currentProfile?.ProfileImageUrl))
                {
                    <img src="@currentProfile.ProfileImageUrl" class="rounded-circle mx-auto mb-3 shadow-sm" style="width: 90px; height: 90px; object-fit: cover; object-position: center; border: 4px solid #fff;" alt="Profile" />
                }
                else
                {
                    <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width:90px;height:90px;">
                        <span class="fw-bold text-primary fs-1">@((currentProfile?.FullName ?? User.Identity?.Name ?? "U").Substring(0,1).ToUpper())</span>
                    </div>
                }
                <h5 class="fw-bold text-dark mb-1">@(currentProfile?.FullName ?? User.Identity?.Name?.Split('@')[0])</h5>
                <div class="text-muted small mb-1">@(currentProfile?.PublicEmail ?? User.Identity?.Name)</div>
                @if (currentProfile?.IsVerified == true)
                {
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill mb-2"><i class="bi bi-patch-check-fill me-1"></i> Verified</span>
                }
                else
                {
                    <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill mb-2"><i class="bi bi-hourglass-split me-1"></i> Pending Verification</span>
                }
                <p class="text-muted small mt-2">Community Hub<br />Share updates or request urgent event/community support.</p>
                <hr />
                <div class="text-start small">
                    <div class="d-flex justify-content-between mb-2"><span><i class="bi bi-person-lines-fill text-primary"></i> My Posts</span><strong>@postCount</strong></div>
                    <div class="d-flex justify-content-between mb-2"><span><i class="bi bi-life-preserver text-danger"></i> My Help</span><strong>@myHelpPostCount</strong></div>
                    <div class="d-flex justify-content-between mb-2"><span><i class="bi bi-chat-left-text text-info"></i> Total Posts</span><strong>@totalPostCount</strong></div>
                    <div class="d-flex justify-content-between"><span><i class="bi bi-broadcast text-success"></i> Community Help</span><strong>@helpPostCount</strong></div>
                </div>
                <div class="alert alert-light border mt-3 mb-0 small text-start">
                    <strong>Community Help</strong> is for urgent event/resource support such as generators, transport, chairs, sound systems, or extra volunteers.
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                @* Form area: collects user input and sends it to the controller action. *@
<form asp-action="CreatePost" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2 mb-3 flex-wrap">
                        @* Input field: binds form data to the model/view model. *@
<input type="radio" class="btn-check" name="postType" id="typeShare" value="Share" checked>
                        <label class="btn btn-outline-primary rounded-pill px-4 fw-bold" for="typeShare">
                            <i class="bi bi-pencil-square me-1"></i> Share Post
                        </label>

                        <input type="radio" class="btn-check" name="postType" id="typeHelp" value="Help">
                        <label class="btn btn-outline-danger rounded-pill px-4 fw-bold" for="typeHelp">
                            <i class="bi bi-life-preserver me-1"></i> Community Help
                        </label>
                    </div>

                    <input type="text" name="title" class="form-control bg-light border-0 mb-3 rounded-3 py-2" placeholder="Post Title..." required />
                    <textarea name="content" class="form-control bg-light border-0 mb-3 rounded-3" rows="3" placeholder="Share an update or explain the urgent community/event help you need..." required></textarea>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">Post to Feed</button>
                </form>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
                <form asp-action="Feed" method="get" class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small fw-bold text-muted">Filter Posts</label>
                        <select name="filter" class="form-select rounded-pill">
                            @if (filter == "All") { <option value="All" selected>All Posts</option> } else { <option value="All">All Posts</option> }
                            @if (filter == "Share") { <option value="Share" selected>Normal Posts</option> } else { <option value="Share">Normal Posts</option> }
                            @if (filter == "Help") { <option value="Help" selected>Community Help Only</option> } else { <option value="Help">Community Help Only</option> }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small fw-bold text-muted">Sort by Time</label>
                        <select name="sortOrder" class="form-select rounded-pill">
                            @if (sortOrder == "Newest") { <option value="Newest" selected>Newest First</option> } else { <option value="Newest">Newest First</option> }
                            @if (sortOrder == "Oldest") { <option value="Oldest" selected>Oldest First</option> } else { <option value="Oldest">Oldest First</option> }
                        </select>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button class="btn btn-dark rounded-pill" type="submit">Apply</button>
                    </div>
                </form>
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="text-center text-muted p-5 bg-white rounded-4 shadow-sm">
                    <i class="bi bi-chat-dots opacity-25" style="font-size: 4rem;"></i>
                    <h5 class="mt-3 fw-bold">No posts found.</h5>
                    <p class="mb-0">Try another filter or start the conversation.</p>
                </div>
            }
            else
            {
                foreach (var post in Model)
                {
                    var canManagePost = manageablePostIds.Contains(post.Id);
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-3 transition-hover">
                        <div class="d-flex justify-content-between mb-3 gap-3">
                            <div class="d-flex align-items-start">
                                @if (!string.IsNullOrEmpty(post.User?.ProfileImageUrl))
                                {
                                    <img src="@post.User.ProfileImageUrl" class="rounded-circle me-3 shadow-sm" style="width: 55px; height: 55px; object-fit: cover; object-position: center; border: 2px solid #fff;" alt="Profile" />
                                }
                                else
                                {
                                    <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 55px; height: 55px; border: 2px solid #fff;">
                                        <span class="fw-bold text-primary">@(post.User?.FullName?.Substring(0, 1).ToUpper() ?? "V")</span>
                                    </div>
                                }
                                <div>
                                    <h6 class="mb-0 fw-bold text-dark">@(post.User?.FullName ?? "Volunteer")</h6>
                                    <small class="text-muted d-block">@(post.User?.PublicEmail ?? "No public email")</small>
                                    <small class="text-muted d-block">@ToSriLankaTime(post.CreatedAt).ToString("MMM dd, yyyy 'at' hh:mm tt")</small>
                                    @if (!string.IsNullOrWhiteSpace(post.User?.OrganizationName))
                                    {
                                        <small class="text-primary d-block"><i class="bi bi-building"></i> @post.User.OrganizationName</small>
                                    }
                                </div>
                            </div>
                            <div class="text-end">
                                @if (post.PostType == "Help")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 align-self-start fw-bold"><i class="bi bi-exclamation-circle me-1"></i> Community Help Needed</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 align-self-start fw-bold"><i class="bi bi-info-circle me-1"></i> Update</span>
                                }
                                @if (canManagePost)
                                {
                                    <div class="mt-2 d-flex gap-1 justify-content-end">
                                        <a asp-action="EditPost" asp-route-id="@post.Id" class="btn btn-sm btn-outline-warning rounded-pill">Edit</a>
                                        <form asp-action="DeletePost" method="post" onsubmit="return confirm('Delete this post?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@post.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">Delete</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">@post.Title</h5>
                        <p class="text-secondary mb-3" style="white-space: pre-line;">@post.Content</p>

                        <hr class="text-muted opacity-25 mt-0 mb-3" />

                        <form asp-action="AddComment" method="post" class="mb-3 d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="postId" value="@post.Id" />
                            <input type="text" name="commentContent" class="form-control bg-light border-0 rounded-pill px-3" placeholder="Write a comment..." required />
                            <button type="submit" class="btn btn-primary rounded-pill px-3"><i class="bi bi-send-fill"></i></button>
                        </form>

                        @if (post.PostComments != null && post.PostComments.Any())
                        {
                            <div class="bg-light p-3 rounded-4 mt-3">
                                <h6 class="fw-bold mb-3 text-secondary small"><i class="bi bi-chat-dots me-1"></i> Comments (@post.PostComments.Count)</h6>
                                @* Loop: repeats this UI block for each item sent by the controller. *@
@foreach (var comment in post.PostComments.OrderBy(c => c.CreatedAt))
                                {
                                    var canManageComment = manageableCommentIds.Contains(comment.Id);
                                    <div class="d-flex mb-2">
                                        @if (!string.IsNullOrEmpty(comment.User?.ProfileImageUrl))
                                        {
                                            <img src="@comment.User.ProfileImageUrl" class="rounded-circle me-2 mt-1" style="width: 25px; height: 25px; object-fit: cover;" alt="Profile" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-circle text-secondary fs-5 me-2 mt-1"></i>
                                        }
                                        <div class="bg-white p-2 px-3 rounded-4 shadow-sm w-100">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fw-bold small text-dark">@(comment.User?.FullName ?? "User")</span>
                                                <div class="d-flex gap-2 align-items-center">
                                                    <span class="text-muted" style="font-size: 0.7rem;">@ToSriLankaTime(comment.CreatedAt).ToString("MMM dd, hh:mm tt")</span>
                                                    @if (canManageComment)
                                                    {
                                                        <form asp-action="DeleteComment" method="post" onsubmit="return confirm('Delete this comment?');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@comment.Id" />
                                                            <button type="submit" class="btn btn-link btn-sm text-danger p-0" title="Delete comment"><i class="bi bi-trash"></i></button>
                                                        </form>
                                                    }
                                                </div>
                                            </div>
                                            <p class="mb-0 small text-secondary">@comment.Content</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>

        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h6 class="fw-bold"><i class="bi bi-lightbulb text-warning me-1"></i> Quick Tip</h6>
                <p class="small text-muted mb-0">Use <strong>Community Help</strong> only for urgent event or community needs. Use <strong>Support Requests</strong> for app bugs, login issues, or system errors.</p>
            </div>
        </div>
    </div>
</div>