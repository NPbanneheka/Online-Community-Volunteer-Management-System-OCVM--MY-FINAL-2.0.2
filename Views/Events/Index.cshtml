@* ================================================================
   VIVA COMMENTED VERSION - Views/Events/Index.cshtml
   Purpose: Razor View file: builds the HTML page shown to the user and displays data supplied by the controller.
   Note: Razor comments do not display to users; they help you explain the page in viva.
   ================================================================ *@

@model IEnumerable<OCVMS.Models.VolunteerEvent>
@{
    ViewData["Title"] = "Volunteer Events";
    var registeredEventIds = ViewBag.UserRegisteredEvents as List<int> ?? new List<int>();
    var manageableEventIds = ViewBag.ManageableEventIds as List<int> ?? new List<int>();
    var statusFilter = (string)(ViewBag.StatusFilter ?? "Active");
    var selectedEventDate = (string?)(ViewBag.EventDate ?? string.Empty);
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Volunteer Events</h1>
            <p class="text-muted mb-0">Browse active events, view registration closing dates, and join opportunities.</p>
        </div>
        @* Conditional UI: shows/hides content based on role, status, or available data. *@
@if (User.IsInRole("Admin") || User.IsInRole("Organizer"))
        {
            @* This form/action creates a new record after validation. *@
<a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold">
                <i class="bi bi-plus-lg me-1"></i> Create New Event
            </a>
        }
    </div>

    @* Form area: collects user input and sends it to the controller action. *@
<form asp-action="Index" method="get" class="mb-5 card border-0 shadow-sm rounded-4 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-lg-5 col-md-12">
                <label class="form-label small fw-bold text-muted">Search</label>
                @* Input field: binds form data to the model/view model. *@
<input type="text" name="searchTerm" class="form-control rounded-pill px-4" placeholder="Search by title, organizer, or organization..." value="@ViewBag.SearchTerm">
            </div>
            <div class="col-lg-3 col-md-4">
                <label class="form-label small fw-bold text-muted">Event Date</label>
                <input type="date" name="eventDate" value="@selectedEventDate" class="form-control rounded-pill px-4" />
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label small fw-bold text-muted">Status</label>
                <select name="statusFilter" class="form-select rounded-pill">
                    @if (statusFilter == "Active") { <option value="Active" selected>Active Events</option> } else { <option value="Active">Active Events</option> }
                    @if (statusFilter == "Upcoming") { <option value="Upcoming" selected>Upcoming Events</option> } else { <option value="Upcoming">Upcoming Events</option> }
                    @if (statusFilter == "Closed") { <option value="Closed" selected>Closed/Completed</option> } else { <option value="Closed">Closed/Completed</option> }
                    @if (statusFilter == "All") { <option value="All" selected>All Events</option> } else { <option value="All">All Events</option> }
                </select>
            </div>
            <div class="col-lg-2 col-md-4 d-grid">
                <button class="btn btn-dark rounded-pill" type="submit">Apply</button>
            </div>
        </div>
    </form>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-light text-center rounded-4 p-5 shadow-sm border-0">
            <i class="bi bi-calendar-x text-muted" style="font-size: 4rem; opacity: 0.5;"></i>
            <h4 class="mt-3 text-muted fw-bold">No events found.</h4>
            <p class="text-secondary">Check back later or try a different search/filter.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @* Loop: repeats this UI block for each item sent by the controller. *@
@foreach (var item in Model)
            {
                var canManage = manageableEventIds.Contains(item.Id);
                var publicStatus = item.PublicStatus;
                var isOpen = publicStatus == "Open";
                var isUpcoming = publicStatus == "Upcoming";
                var isClosed = publicStatus == "Closed" || publicStatus == "Completed" || publicStatus == "Cancelled";
                var badgeCss = publicStatus switch
                {
                    "Open" => "bg-success bg-opacity-10 text-success",
                    "Upcoming" => "bg-info bg-opacity-10 text-info",
                    "Cancelled" => "bg-danger bg-opacity-10 text-danger",
                    "Completed" => "bg-dark bg-opacity-10 text-dark",
                    _ => "bg-secondary bg-opacity-10 text-secondary"
                };
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="event-card-image" alt="@item.Title" />
                        }
                        else
                        {
                            <div class="bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="height: 170px;">
                                <i class="bi bi-calendar-event text-primary opacity-25" style="font-size: 4rem;"></i>
                            </div>
                        }
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
                                <h5 class="fw-bold text-dark mb-1">@item.Title</h5>
                                <span class="badge @badgeCss rounded-pill">@publicStatus</span>
                            </div>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-geo-alt-fill text-danger"></i> @item.Location<br/>
                                <i class="bi bi-calendar3 text-primary"></i> Event: @item.EventDate.ToString("MMM dd, yyyy")<br/>
                                <i class="bi bi-clock text-warning"></i> @item.EventTime.ToString(@"hh\:mm")<br/>
                                <i class="bi bi-hourglass-split text-info"></i> Registration closes: @(item.RegistrationClosingDate?.ToString("MMM dd, yyyy") ?? item.EventDate.ToString("MMM dd, yyyy"))
                            </p>

                            <div class="mb-2 small text-muted">
                                <i class="bi bi-person-badge text-info"></i> @(item.OrganizerProfile?.FullName ?? "Organizer")
                                @if (item.OrganizerProfile?.IsVerified == true)
                                {
                                    <i class="bi bi-patch-check-fill text-success ms-1" title="Verified organizer"></i>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.OrganizerProfile?.OrganizationName))
                                {
                                    <span> · @item.OrganizerProfile.OrganizationName</span>
                                }
                            </div>

                            <div class="mb-3 small text-muted">
                                <i class="bi bi-people text-success"></i> @(item.Registrations?.Count ?? 0) / @item.Capacity registered
                            </div>

                            <div class="mt-auto">
                                @if (canManage)
                                {
                                    <div class="d-flex gap-2 mb-2">
                                        <a asp-action="JoinedVolunteers" asp-route-id="@item.Id" class="btn btn-info btn-sm rounded-pill w-50 fw-bold text-white">Volunteers</a>
                                        @* This form/action updates an existing record after permission checks. *@
<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm rounded-pill w-50 fw-bold">Edit</a>
                                    </div>
                                }
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    if (registeredEventIds.Contains(item.Id))
                                    {
                                        <div class="btn btn-success w-100 rounded-pill fw-bold disabled mb-2">
                                            <i class="bi bi-check-circle-fill me-2"></i> Already Registered
                                        </div>
                                    }
                                    else if (isClosed)
                                    {
                                        <div class="btn btn-secondary w-100 rounded-pill fw-bold disabled mb-2">Registration Closed</div>
                                    }
                                    else if (isUpcoming)
                                    {
                                        <div class="btn btn-info text-white w-100 rounded-pill fw-bold disabled mb-2">Opens Soon</div>
                                    }
                                    else
                                    {
                                        <form asp-controller="Events" asp-action="Register" method="post" class="mb-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="eventId" value="@item.Id" />
                                            <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">Register Now</button>
                                        </form>
                                    }
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary w-100 rounded-pill fw-bold mb-2">Login to Register</a>
                                }
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@item.Id" class="btn btn-light text-primary w-100 rounded-pill fw-bold border">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
