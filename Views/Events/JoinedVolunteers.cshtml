@* ================================================================
   VIVA COMMENTED VERSION - Views/Events/JoinedVolunteers.cshtml
   Purpose: Razor View file: builds the HTML page shown to the user and displays data supplied by the controller.
   Note: Razor comments do not display to users; they help you explain the page in viva.
   ================================================================ *@

@model OCVMS.Models.VolunteerEvent
@{
    ViewData["Title"] = "Joined Volunteers";
    var profiles = ViewBag.VolunteerProfiles as List<UserProfile> ?? new List<UserProfile>();
    var organizerRatings = ViewBag.OrganizerRatings as Dictionary<string, UserRating> ?? new Dictionary<string, UserRating>();
    var volunteerAverageRatings = ViewBag.VolunteerAverageRatings as Dictionary<string, double> ?? new Dictionary<string, double>();
    var volunteerRatingCounts = ViewBag.VolunteerRatingCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Joined Volunteers</h2>
            <p class="text-muted mb-0">@Model.Title · @profiles.Count / @Model.Capacity registered</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light rounded-pill px-4 fw-bold">Back to Event</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            @* Conditional UI: shows/hides content based on role, status, or available data. *@
@if (!profiles.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 text-center p-5">
                    <i class="bi bi-people text-muted opacity-25" style="font-size:4rem;"></i>
                    <h4 class="text-muted mt-3">No volunteers have joined yet.</h4>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    @* Table: displays multiple records in a readable admin/user list. *@
<table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Volunteer</th><th>Email</th><th>Contact</th><th>Verified</th><th style="width: 320px;">Organizer Rating</th></tr>
                        </thead>
                        <tbody>
                        @* Loop: repeats this UI block for each item sent by the controller. *@
@foreach (var profile in profiles)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(profile.ProfileImageUrl))
                                        {
                                            <img src="@profile.ProfileImageUrl" class="rounded-circle" style="width:45px;height:45px;object-fit:cover;" alt="Profile" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width:45px;height:45px;"><span class="fw-bold text-primary">@profile.FullName.Substring(0,1).ToUpper()</span></div>
                                        }
                                        <div>
                                            <div class="fw-bold">@profile.FullName</div>
                                            <small class="text-muted">@profile.RoleName</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@(profile.PublicEmail ?? "Not provided")</td>
                                <td>@(profile.ContactNumber ?? "Not provided")</td>
                                <td>
                                    @if (profile.IsVerified)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill">Verified</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill">Pending</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        organizerRatings.TryGetValue(profile.UserId, out var myVolunteerRating);
                                        volunteerAverageRatings.TryGetValue(profile.UserId, out var volunteerAverageRating);
                                        volunteerRatingCounts.TryGetValue(profile.UserId, out var volunteerRatingCount);
                                    }
                                    <div class="small text-muted mb-2">
                                        @if (volunteerRatingCount > 0)
                                        {
                                            <span><i class="bi bi-star-fill text-warning me-1"></i>Volunteer average: @volunteerAverageRating.ToString("0.0") (@volunteerRatingCount)</span>
                                        }
                                        else
                                        {
                                            <span>No ratings for this volunteer yet.</span>
                                        }
                                    </div>
                                    @* Form area: collects user input and sends it to the controller action. *@
<form asp-action="RateVolunteer" method="post" class="row g-2">
                                        @Html.AntiForgeryToken()
                                        @* Input field: binds form data to the model/view model. *@
<input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="volunteerUserId" value="@profile.UserId" />
                                        <div class="col-4">
                                            <select name="score" class="form-select form-select-sm rounded-pill" required>
                                                @for (int i = 5; i >= 1; i--)
                                                {
                                                    if (myVolunteerRating?.Score == i)
                                                    {
                                                        <option value="@i" selected>@i Stars</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@i">@i Stars</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div class="col-8">
                                            <input name="reviewText" class="form-control form-control-sm rounded-pill" placeholder="Optional note" value="@myVolunteerRating?.ReviewText" />
                                        </div>
                                        <div class="col-12 d-grid">
                                            <button type="submit" class="btn btn-sm btn-warning rounded-pill fw-bold">@(myVolunteerRating == null ? "Save Rating" : "Update Rating")</button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-2"><i class="bi bi-megaphone text-primary me-1"></i> Send Event Notice</h5>
                <p class="text-muted small">This message will be sent as a notification to all volunteers registered for this event.</p>
                <form asp-action="SendVolunteerNotification" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <textarea name="message" class="form-control rounded-3 mb-3" rows="5" placeholder="E.g., Please arrive 15 minutes early and bring your ID card." required></textarea>
                    <button type="submit" class="btn btn-primary rounded-pill w-100 fw-bold">Send Notification</button>
                </form>
            </div>
        </div>
    </div>
</div>
