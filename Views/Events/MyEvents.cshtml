@* Views/Events/MyEvents.cshtml: Razor view that renders the Events/MyEvents page in the browser. Comments describe UI/data purpose only. *@
@* @model declares the C# type this Razor page receives from its controller. *@
@model IEnumerable<OCVMS.Models.VolunteerEvent>
@* Razor code block prepares page variables such as title, filters, or values from ViewBag/ViewData. *@
@{
    ViewData["Title"] = "My Registered Events";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">My Registered Events</h2>
        @* Tag Helpers generate correct MVC URLs for controller actions. *@
        <a asp-controller="Events" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">Find More Events</a>
    </div>

    @* Conditional UI: renders this section only when the condition is true. *@
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5">
            <i class="bi bi-calendar-x text-muted" style="font-size: 4rem; opacity: 0.3;"></i>
            <h4 class="text-muted mt-3">You haven't registered for any events yet.</h4>
            <p class="text-secondary">Explore our events and start making an impact today!</p>
            @* Tag Helpers generate correct MVC URLs for controller actions. *@
            <div class="mt-3"><a asp-controller="Events" asp-action="Index" class="btn btn-primary rounded-pill px-5 py-2 fw-bold">Explore Events</a></div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @* Loops through the model/list data and renders one UI section for each record. *@
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        @* Conditional UI: renders this section only when the condition is true. *@
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="event-card-image" alt="@item.Title" />
                        }
                        else
                        {
                            <div class="bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="height: 160px;"><i class="bi bi-calendar-event text-primary opacity-25" style="font-size: 4rem;"></i></div>
                        }
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Registered</span>
                                <small class="text-muted"><i class="bi bi-clock"></i> @item.EventTime.ToString(@"hh\:mm")</small>
                            </div>
                            <h5 class="fw-bold text-dark">@item.Title</h5>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-geo-alt-fill text-danger"></i> @item.Location<br/>
                                <i class="bi bi-calendar-check text-primary"></i> @item.EventDate.ToString("MMM dd, yyyy")<br/>
                                <i class="bi bi-hourglass-split text-info"></i> Closes: @(item.RegistrationClosingDate?.ToString("MMM dd, yyyy") ?? "Not set")
                            </p>

                            <div class="d-grid gap-2 mt-4">
                                @* Tag Helpers generate correct MVC URLs for controller actions. *@
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary rounded-pill fw-bold">View Details</a>
                                @* Form sends user input back to a controller action for validation and processing. *@
                                <form asp-controller="Events" asp-action="Unregister" method="post" onsubmit="return confirm('Are you sure you want to cancel your registration?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="eventId" value="@item.Id" />
                                    <button type="submit" class="btn btn-light text-danger w-100 rounded-pill fw-bold"><i class="bi bi-x-circle me-1"></i> Cancel Registration</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
