@* Views/Events/Details.cshtml: Razor view that renders the Events/Details page in the browser. Comments describe UI/data purpose only. *@
@* @model declares the C# type this Razor page receives from its controller. *@
@model OCVMS.Models.VolunteerEvent
@* Razor code block prepares page variables such as title, filters, or values from ViewBag/ViewData. *@
@{
    ViewData["Title"] = "Event Details";
    bool isRegistered = ViewBag.IsRegistered ?? false;
    int registeredCount = ViewBag.RegisteredCount ?? 0;
    int remainingSlots = ViewBag.RemainingSlots ?? 0;
    bool canManageEvent = ViewBag.CanManageEvent ?? false;
    bool canRate = ViewBag.CanRate ?? false;
    var myRating = ViewBag.MyRating as UserRating;
    double averageRating = ViewBag.AverageRating ?? 0.0;
    int ratingCount = ViewBag.RatingCount ?? 0;
    var isRegistrationOpen = Model.IsRegistrationOpen;
    var publicStatus = (string?)(ViewBag.PublicStatus ?? Model.PublicStatus) ?? Model.Status;
    var statusBadgeClass = publicStatus switch
    {
        "Open" => "bg-success bg-opacity-10 text-success",
        "Upcoming" => "bg-info bg-opacity-10 text-info",
        "Cancelled" => "bg-danger bg-opacity-10 text-danger",
        "Completed" => "bg-dark bg-opacity-10 text-dark",
        _ => "bg-secondary bg-opacity-10 text-secondary"
    };
}

<div class="container py-5">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        @* Conditional UI: renders this section only when the condition is true. *@
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="w-100" style="height: 320px; object-fit: cover; object-position: center;" alt="@Model.Title" />
        }
        else
        {
            <div class="bg-primary bg-opacity-10 p-5 text-center">
                <i class="bi bi-calendar-star text-primary opacity-50" style="font-size: 5rem;"></i>
            </div>
        }
        <div class="bg-white p-4 text-center border-bottom">
            <h2 class="fw-bold text-dark mt-2">@Model.Title</h2>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <span class="badge @statusBadgeClass rounded-pill px-3 py-2">@publicStatus</span>
                @* Conditional UI: renders this section only when the condition is true. *@
                @if (publicStatus == "Upcoming")
                {
                    <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-2">Registration Opens Soon</span>
                }
                else
                {
                    <span class="badge @(isRegistrationOpen ? "bg-success" : "bg-secondary") bg-opacity-10 @(isRegistrationOpen ? "text-success" : "text-secondary") rounded-pill px-3 py-2">@(isRegistrationOpen ? "Registration Open" : "Registration Closed")</span>
                }
                @* Conditional UI: renders this section only when the condition is true. *@
                @if (ratingCount > 0)
                {
                    <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-2"><i class="bi bi-star-fill"></i> @averageRating.ToString("0.0") (@ratingCount)</span>
                }
            </div>
        </div>
        
        <div class="card-body p-4 p-md-5">
            <div class="row g-5">
                <div class="col-lg-7">
                    <h4 class="fw-bold border-bottom pb-2 mb-4">About the Event</h4>
                    <p class="text-secondary" style="white-space: pre-line; line-height: 1.8;">@Model.Description</p>

                    @* Conditional UI: renders this section only when the condition is true. *@
                    @if (canRate)
                    {
                        <div class="card border-0 bg-light rounded-4 p-4 mt-4">
                            <h5 class="fw-bold mb-3"><i class="bi bi-star text-warning me-1"></i> Rate this Event</h5>
                            @* Form sends user input back to a controller action for validation and processing. *@
                            <form asp-action="RateEvent" method="post" class="row g-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <div class="col-md-3">
                                    <select name="score" class="form-select rounded-pill" required>
                                        @for (int i = 5; i >= 1; i--)
                                        {
                                            if (myRating?.Score == i)
                                            {
                                                <option value="@i" selected>@i Stars</option>
                                            }
                                            else
                                            {
                                                <option value="@i">@i Stars</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-7">
                                    <input name="reviewText" class="form-control rounded-pill" placeholder="Optional short review" value="@myRating?.ReviewText" />
                                </div>
                                <div class="col-md-2 d-grid">
                                    <button type="submit" class="btn btn-warning rounded-pill fw-bold">Save</button>
                                </div>
                            </form>
                        </div>
                    }
                </div>
                
                <div class="col-lg-5">
                    <div class="bg-light p-4 rounded-4 shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold mb-0">Event Info</h5>
                            <span class="badge @statusBadgeClass rounded-pill px-3 py-2">@publicStatus</span>
                        </div>
                        
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-white p-2 rounded shadow-sm me-3"><i class="bi bi-calendar-event text-primary fs-5"></i></div>
                            <div><small class="text-muted d-block">Event Date</small><span class="fw-bold text-dark">@Model.EventDate.ToString("MMMM dd, yyyy")</span></div>
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-white p-2 rounded shadow-sm me-3"><i class="bi bi-clock text-warning fs-5"></i></div>
                            <div><small class="text-muted d-block">Time</small><span class="fw-bold text-dark">@Model.EventTime.ToString(@"hh\:mm")</span></div>
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-white p-2 rounded shadow-sm me-3"><i class="bi bi-door-open text-success fs-5"></i></div>
                            <div><small class="text-muted d-block">Open Date</small><span class="fw-bold text-dark">@Model.RegistrationOpenDate.ToString("MMMM dd, yyyy")</span></div>
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-white p-2 rounded shadow-sm me-3"><i class="bi bi-hourglass-split text-danger fs-5"></i></div>
                            <div><small class="text-muted d-block">Closing Date</small><span class="fw-bold text-dark">@(Model.RegistrationClosingDate?.ToString("MMMM dd, yyyy") ?? "Not set")</span></div>
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-white p-2 rounded shadow-sm me-3"><i class="bi bi-geo-alt text-danger fs-5"></i></div>
                            <div><small class="text-muted d-block">Location</small><span class="fw-bold text-dark">@Model.Location</span></div>
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-white p-2 rounded shadow-sm me-3"><i class="bi bi-person-badge text-info fs-5"></i></div>
                            <div>
                                <small class="text-muted d-block">Organizer</small>
                                <span class="fw-bold text-dark">@(Model.OrganizerProfile?.FullName ?? "Organizer")</span>
                                @* Conditional UI: renders this section only when the condition is true. *@
                                @if (Model.OrganizerProfile?.IsVerified == true)
                                {
                                    <i class="bi bi-patch-check-fill text-success ms-1"></i>
                                }
                                @* Conditional UI: renders this section only when the condition is true. *@
                                @if (!string.IsNullOrWhiteSpace(Model.OrganizerProfile?.OrganizationName))
                                {
                                    <small class="d-block text-primary">@Model.OrganizerProfile.OrganizationName</small>
                                }
                            </div>
                        </div>
                        <div class="d-flex align-items-center mb-4">
                            <div class="bg-white p-2 rounded shadow-sm me-3"><i class="bi bi-people text-success fs-5"></i></div>
                            <div>
                                <small class="text-muted d-block">Capacity</small>
                                @* Conditional UI: renders this section only when the condition is true. *@
                                @if (canManageEvent)
                                {
                                    @* Tag Helpers generate correct MVC URLs for controller actions. *@
                                    <a asp-action="JoinedVolunteers" asp-route-id="@Model.Id" class="fw-bold text-dark text-decoration-none">@registeredCount / @Model.Capacity registered (@remainingSlots left)</a>
                                    <small class="d-block text-muted">Click to view volunteers and send event notices.</small>
                                }
                                else
                                {
                                    <span class="fw-bold text-dark">@registeredCount / @Model.Capacity registered (@remainingSlots left)</span>
                                }
                            </div>
                        </div>
                        
                        @* Conditional UI: renders this section only when the condition is true. *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (isRegistered)
                            {
                                @* Form sends user input back to a controller action for validation and processing. *@
                                <form asp-action="Unregister" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="eventId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-outline-danger w-100 rounded-pill fw-bold">Cancel Registration</button>
                                </form>
                            }
                            else if (publicStatus == "Upcoming")
                            {
                                <button class="btn btn-info text-white w-100 rounded-pill fw-bold" disabled>Registration Opens Soon</button>
                            }
                            else if (!isRegistrationOpen)
                            {
                                <button class="btn btn-secondary w-100 rounded-pill fw-bold" disabled>Registration Closed</button>
                            }
                            else
                            {
                                @* Form sends user input back to a controller action for validation and processing. *@
                                <form asp-action="Register" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="eventId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold py-2">Register Now</button>
                                </form>
                            }
                        }
                        else
                        {
                            @* Tag Helpers generate correct MVC URLs for controller actions. *@
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100 rounded-pill fw-bold">Login to Register</a>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-5">
                @* Tag Helpers generate correct MVC URLs for controller actions. *@
                <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold">Back to Events</a>
                @* Conditional UI: renders this section only when the condition is true. *@
                @if (canManageEvent)
                {
                    @* Tag Helpers generate correct MVC URLs for controller actions. *@
                    <a asp-action="JoinedVolunteers" asp-route-id="@Model.Id" class="btn btn-info text-white rounded-pill px-4 fw-bold">Joined Volunteers</a>
                    @* Tag Helpers generate correct MVC URLs for controller actions. *@
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4 fw-bold">Edit Event</a>
                    @* Form sends user input back to a controller action for validation and processing. *@
                    <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this event?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-4 fw-bold">Delete Event</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
