@using OCVMS.Models
@{
    ViewData["Title"] = "About";
    double appAverageRating = ViewBag.AppAverageRating ?? 0.0;
    int appRatingCount = ViewBag.AppRatingCount ?? 0;
    var myAppRating = ViewBag.MyAppRating as UserRating;
}

<div class="container py-5">
    <div class="card card-modern p-5 mb-4">
        <h1 class="fw-bold mb-3">About OCVMS</h1>
        <p class="text-muted mb-3">OCVMS is a web-based system for volunteer management, event organization, reputation tracking, and community engagement.</p>
        <div class="d-flex flex-wrap gap-3 align-items-center">
            @if (appRatingCount > 0)
            {
                <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-4 py-3">
                    <i class="bi bi-star-fill me-1"></i> Overall Platform Rating: @appAverageRating.ToString("0.0") / 5
                </span>
                <span class="text-muted">Based on @appRatingCount rating(s)</span>
            }
            else
            {
                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-4 py-3">No platform ratings yet</span>
            }
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success rounded-4 border-0 shadow-sm">@TempData["Message"]</div>
    }

    <div class="card card-modern p-5">
        <h3 class="fw-bold mb-2">Rate the OCVMS Platform</h3>
        <p class="text-muted">All logged-in users can share a rating for the overall web application experience. This average will be shown on the admin dashboard.</p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-action="RateApplication" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Your Rating</label>
                    <select name="score" class="form-select rounded-pill" required>
                        @for (int i = 5; i >= 1; i--)
                        {
                            if (myAppRating?.Score == i)
                            {
                                <option value="@i" selected>@i Stars</option>
                            }
                            else
                            {
                                <option value="@i">@i Stars</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-9">
                    <label class="form-label fw-semibold">Short Review (Optional)</label>
                    <input name="reviewText" class="form-control rounded-pill" placeholder="Share a short comment about the platform" value="@myAppRating?.ReviewText" />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold">@(myAppRating == null ? "Submit Platform Rating" : "Update Platform Rating")</button>
                </div>
            </form>
        }
        else
        {
            <div class="alert alert-info rounded-4 border-0 mb-0">Please log in to rate the platform.</div>
        }
    </div>
</div>
