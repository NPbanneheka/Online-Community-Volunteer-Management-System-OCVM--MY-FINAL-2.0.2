@{
    ViewData["Title"] = "Home";
    var featuredEvents = ViewBag.FeaturedEvents as List<VolunteerEvent> ?? new();
}

<section class="hero-section rounded-4 p-5 mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-7 text-white">
            <span class="badge bg-light text-dark rounded-pill px-3 py-2 mb-3">Build community. Create impact.</span>
            <h1 class="display-5 fw-bold mb-3">A modern volunteer platform with trust, profiles, ratings, and events.</h1>
            <p class="lead opacity-75">Connect volunteers, organizers, and communities in one clean and attractive platform.</p>
            <div class="d-flex gap-3 flex-wrap mt-4">
                <a class="btn btn-light btn-lg rounded-pill px-4" asp-controller="Account" asp-action="Register">Join as Volunteer</a>
                <a class="btn btn-outline-light btn-lg rounded-pill px-4" asp-controller="Events" asp-action="Index">Explore Events</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="glass-card p-4 text-white">
                <div class="row g-3 text-center">
                    <div class="col-4"><div class="stat-number">@ViewBag.Stats.Users</div><small>Users</small></div>
                    <div class="col-4"><div class="stat-number">@ViewBag.Stats.Events</div><small>Events</small></div>
                    <div class="col-4"><div class="stat-number">@ViewBag.Stats.Registrations</div><small>Registrations</small></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="section-title">Featured Events</h2>
        <a asp-controller="Events" asp-action="Index" class="btn btn-outline-primary rounded-pill">See all</a>
    </div>
    <div class="row g-4">
        @foreach (var item in featuredEvents)
        {
            <div class="col-md-4">
                <div class="card card-modern h-100">
                    <div class="card-body p-4">
                        <span class="badge bg-primary-subtle text-primary mb-2">@item.Status</span>
                        <h5 class="fw-bold">@item.Title</h5>
                        <p class="text-muted small mb-3">@item.Description</p>
                        <div class="small mb-1"><i class="bi bi-calendar-event me-2"></i>@item.EventDate.ToString("dd MMM yyyy")</div>
                        <div class="small"><i class="bi bi-geo-alt me-2"></i>@item.Location</div>
                    </div>
                    <div class="card-footer bg-transparent border-0 px-4 pb-4">
                        <a class="btn btn-gradient w-100 rounded-pill" asp-controller="Events" asp-action="Details" asp-route-id="@item.Id">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section class="row g-4">
    <div class="col-md-4"><div class="card card-modern p-4 h-100"><h5>Profiles & Ratings</h5><p class="text-muted mb-0">Users create profiles, build trust, and grow reputation after real events.</p></div></div>
    <div class="col-md-4"><div class="card card-modern p-4 h-100"><h5>Community Feed</h5><p class="text-muted mb-0">Share updates, event announcements, and community engagement posts.</p></div></div>
    <div class="col-md-4"><div class="card card-modern p-4 h-100"><h5>Role-based Control</h5><p class="text-muted mb-0">Admins, organizers, and volunteers each get a focused experience.</p></div></div>
</section>
