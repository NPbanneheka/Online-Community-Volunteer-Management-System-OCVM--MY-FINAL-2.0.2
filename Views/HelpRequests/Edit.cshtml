@* Views/HelpRequests/Edit.cshtml: Razor view that renders the HelpRequests/Edit page in the browser. Comments describe UI/data purpose only. *@
@* @model declares the C# type this Razor page receives from its controller. *@
@model OCVMS.Models.HelpRequest
@* Razor code block prepares page variables such as title, filters, or values from ViewBag/ViewData. *@
@{
    ViewData["Title"] = "Edit Support Request";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5">
                <h2 class="fw-bold mb-2">Edit Support Request</h2>
                <p class="text-muted mb-4">Only the request owner or admin can edit this support request.</p>

                @* Form sends user input back to a controller action for validation and processing. *@
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    @* asp-for binds this input to a ViewModel or Model property. *@
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Support Request Title</label>
                        @* asp-for binds this input to a ViewModel or Model property. *@
                        <input asp-for="Title" class="form-control rounded-3" />
                        @* Displays server/client validation messages for the connected input property. *@
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold">Description</label>
                        @* asp-for binds this input to a ViewModel or Model property. *@
                        <textarea asp-for="Description" class="form-control rounded-3" rows="5"></textarea>
                        @* Displays server/client validation messages for the connected input property. *@
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-warning rounded-pill px-5 fw-bold">Save Changes</button>
                    @* Tag Helpers generate correct MVC URLs for controller actions. *@
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light rounded-pill px-4 ms-2 fw-bold">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
