@model OCVMS.Models.HelpRequest
@{
    ViewData["Title"] = "Help Request Details";
    var statuses = new[] { "Pending", "In Progress", "Resolved", "Closed" };
    bool canManageHelpRequest = ViewBag.CanManageHelpRequest ?? false;
    bool canUpdateHelpRequestStatus = ViewBag.CanUpdateHelpRequestStatus ?? false;
}

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
            <div>
                <h2 class="fw-bold mb-1">@Model.Title</h2>
                <p class="text-muted mb-0">
                    Submitted by @(Model.SubmittedBy?.FullName ?? "User") on @Model.CreatedAt.ToString("MMM dd, yyyy")
                    @if (!string.IsNullOrWhiteSpace(Model.SubmittedBy?.OrganizationName))
                    {
                        <span> · @Model.SubmittedBy.OrganizationName</span>
                    }
                </p>
            </div>
            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-4 py-2">@Model.Status</span>
        </div>

        <div class="bg-light rounded-4 p-4 mb-4">
            <h6 class="fw-bold text-secondary">Description</h6>
            <p class="mb-0" style="white-space:pre-line;">@Model.Description</p>
        </div>

        @if (canUpdateHelpRequestStatus)
        {
            <form asp-action="UpdateStatus" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="col-md-5">
                    <label class="form-label fw-bold">Update Status</label>
                    <select name="status" class="form-select rounded-3">
                        @foreach (var status in statuses)
                        {
                            if (Model.Status == status)
                            {
                                <option value="@status" selected>@status</option>
                            }
                            else
                            {
                                <option value="@status">@status</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold">Save Status</button>
                </div>
            </form>
        }

        <div class="mt-4 d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold text-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            @if (canManageHelpRequest)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4 fw-bold">Edit Request</a>
                <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this help request?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger rounded-pill px-4 fw-bold">Delete Request</button>
                </form>
            }
        </div>
    </div>
</div>
