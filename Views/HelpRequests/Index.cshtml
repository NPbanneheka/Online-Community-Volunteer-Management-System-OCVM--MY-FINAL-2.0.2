@* ================================================================
   VIVA COMMENTED VERSION - Views/HelpRequests/Index.cshtml
   Purpose: Razor View file: builds the HTML page shown to the user and displays data supplied by the controller.
   Note: Razor comments do not display to users; they help you explain the page in viva.
   ================================================================ *@

@model IEnumerable<OCVMS.Models.HelpRequest>
@using System.Runtime.InteropServices
@{
    ViewData["Title"] = "Support Requests";
    var manageableHelpRequestIds = ViewBag.ManageableHelpRequestIds as List<int> ?? new List<int>();
}

@functions {
    private DateTime ToSriLankaTime(DateTime value)
    {
        if (value == DateTime.MinValue) return value;

        var utcValue = value.Kind == DateTimeKind.Utc
            ? value
            : DateTime.SpecifyKind(value, DateTimeKind.Utc);

        var timeZoneId = RuntimeInformation.IsOSPlatform(OSPlatform.Windows)
            ? "Sri Lanka Standard Time"
            : "Asia/Colombo";

        var sriLankaTimeZone = TimeZoneInfo.FindSystemTimeZoneById(timeZoneId);
        return TimeZoneInfo.ConvertTimeFromUtc(utcValue, sriLankaTimeZone);
    }
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Support Requests</h2>
            <p class="text-muted mb-0">Report system issues, bugs, errors, or difficulties to the admin team.</p>
        </div>
        @* This form/action creates a new record after validation. *@
<a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold">
            <i class="bi bi-plus-circle me-1"></i> New Support Request
        </a>
    </div>

    @* Conditional UI: shows/hides content based on role, status, or available data. *@
@if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5">
            <i class="bi bi-life-preserver text-muted opacity-25" style="font-size:4rem;"></i>
            <h4 class="text-muted mt-3">No support requests found.</h4>
            <p class="text-secondary">Submit a support request if you face an issue while using the system.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @* Loop: repeats this UI block for each item sent by the controller. *@
@foreach (var item in Model)
            {
                var statusClass = item.Status switch
                {
                    "Resolved" => "success",
                    "Closed" => "secondary",
                    "In Progress" => "warning",
                    _ => "primary"
                };
                var canManage = manageableHelpRequestIds.Contains(item.Id);

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between gap-2 mb-2">
                                <h5 class="fw-bold mb-0">@item.Title</h5>
                                <span class="badge bg-@statusClass bg-opacity-10 text-@statusClass rounded-pill px-3 py-2">@item.Status</span>
                            </div>
                            <p class="text-secondary small mb-3">@item.Description</p>
                            <div class="text-muted small mb-3">
                                <i class="bi bi-person me-1"></i> @(item.SubmittedBy?.FullName ?? "User")
                                @if (!string.IsNullOrWhiteSpace(item.SubmittedBy?.OrganizationName))
                                {
                                    <span class="mx-2">·</span><i class="bi bi-building me-1"></i> @item.SubmittedBy.OrganizationName
                                }
                                <span class="mx-2">·</span>
                                <i class="bi bi-calendar3 me-1"></i> @ToSriLankaTime(item.CreatedAt).ToString("MMM dd, yyyy hh:mm tt")
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary rounded-pill px-4 fw-bold">Open</a>
                                @if (canManage)
                                {
                                    @* This form/action updates an existing record after permission checks. *@
<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning rounded-pill px-4 fw-bold">Edit</a>
                                    @* Form area: collects user input and sends it to the controller action. *@
@* Delete action is protected by controller-side permission checks. *@
<form asp-action="Delete" method="post" onsubmit="return confirm('Delete this support request?');">
                                        @Html.AntiForgeryToken()
                                        @* Input field: binds form data to the model/view model. *@
<input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger rounded-pill px-4 fw-bold">Delete</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>