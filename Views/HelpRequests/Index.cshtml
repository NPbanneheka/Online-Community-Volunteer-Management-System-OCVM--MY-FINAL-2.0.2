@model IEnumerable<OCVMS.Models.HelpRequest>
@{
    ViewData["Title"] = "Help Requests";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Help Requests</h2>
            <p class="text-muted mb-0">Track community support requests and their current status.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold">
            <i class="bi bi-plus-circle me-1"></i> New Request
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5">
            <i class="bi bi-life-preserver text-muted opacity-25" style="font-size:4rem;"></i>
            <h4 class="text-muted mt-3">No help requests found.</h4>
            <p class="text-secondary">Create a request when community support is needed.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                var statusClass = item.Status switch
                {
                    "Resolved" => "success",
                    "Closed" => "secondary",
                    "In Progress" => "warning",
                    _ => "primary"
                };

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between gap-2 mb-2">
                                <h5 class="fw-bold mb-0">@item.Title</h5>
                                <span class="badge bg-@statusClass bg-opacity-10 text-@statusClass rounded-pill px-3 py-2">@item.Status</span>
                            </div>
                            <p class="text-secondary small mb-3">@item.Description</p>
                            <div class="text-muted small mb-3">
                                <i class="bi bi-person me-1"></i> @(item.SubmittedBy?.FullName ?? "User")
                                <span class="mx-2">·</span>
                                <i class="bi bi-calendar3 me-1"></i> @item.CreatedAt.ToString("MMM dd, yyyy")
                            </div>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary rounded-pill px-4 fw-bold">Open</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
