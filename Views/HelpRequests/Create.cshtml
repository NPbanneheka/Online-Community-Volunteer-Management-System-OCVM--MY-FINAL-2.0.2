@* Views/HelpRequests/Create.cshtml: Razor view that renders the HelpRequests/Create page in the browser. Comments describe UI/data purpose only. *@
@* @model declares the C# type this Razor page receives from its controller. *@
@model OCVMS.Models.HelpRequest
@* Razor code block prepares page variables such as title, filters, or values from ViewBag/ViewData. *@
@{
    ViewData["Title"] = "Create Support Request";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5">
                <h2 class="fw-bold mb-2">Create Support Request</h2>
                <p class="text-muted mb-4">Report a system issue, bug, error, login problem, or difficulty to the admin team.</p>

                @* Form sends user input back to a controller action for validation and processing. *@
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Support Request Title</label>
                        @* asp-for binds this input to a ViewModel or Model property. *@
                        <input asp-for="Title" class="form-control rounded-3" placeholder="E.g., Login issue, event registration error, profile update problem" />
                        @* Displays server/client validation messages for the connected input property. *@
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold">Description</label>
                        @* asp-for binds this input to a ViewModel or Model property. *@
                        <textarea asp-for="Description" class="form-control rounded-3" rows="5" placeholder="Explain the issue you faced, what page you used, and what you expected to happen..."></textarea>
                        @* Displays server/client validation messages for the connected input property. *@
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold">Submit Support Request</button>
                    @* Tag Helpers generate correct MVC URLs for controller actions. *@
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4 ms-2 fw-bold">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
