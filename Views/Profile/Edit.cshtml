@model ProfileEditViewModel
@{ ViewData["Title"] = "Edit Profile"; }
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-modern p-4 p-lg-5">
            <h2 class="fw-bold mb-4">Edit Profile</h2>
            <form method="post">
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control form-control-modern" /></div>
                    <div class="col-md-6"><label asp-for="PublicEmail" class="form-label"></label><input asp-for="PublicEmail" class="form-control form-control-modern" /></div>
                    <div class="col-md-6"><label asp-for="ContactNumber" class="form-label"></label><input asp-for="ContactNumber" class="form-control form-control-modern" /></div>
                    <div class="col-md-6"><label asp-for="Availability" class="form-label"></label><input asp-for="Availability" class="form-control form-control-modern" /></div>
                    <div class="col-md-6"><label asp-for="Skills" class="form-label"></label><input asp-for="Skills" class="form-control form-control-modern" /></div>
                    <div class="col-md-6"><label asp-for="OrganizationName" class="form-label"></label><input asp-for="OrganizationName" class="form-control form-control-modern" /></div>
                    <div class="col-12"><label asp-for="ProfileImageUrl" class="form-label"></label><input asp-for="ProfileImageUrl" class="form-control form-control-modern" /></div>
                    <div class="col-12"><label asp-for="Bio" class="form-label"></label><textarea asp-for="Bio" rows="4" class="form-control form-control-modern"></textarea></div>
                </div>
                <button class="btn btn-gradient rounded-pill px-4 mt-4">Save Changes</button>
            </form>
        </div>
    </div>
</div>
