@using System.Collections.Generic
@model IEnumerable<OCVMS.Models.UserProfile>

@{
    ViewData["Title"] = "User Management";
    var bannedStatus = ViewBag.BannedStatus as Dictionary<string, bool> ?? new Dictionary<string, bool>();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">User Management</h2>
            <p class="text-muted mb-0">
                Admin can verify, ban, unban, or remove problematic organizer and volunteer accounts.
            </p>
        </div>
    </div>

    <div class="alert alert-info rounded-4 border-0">
        <i class="bi bi-info-circle me-2"></i>
        Admin can temporarily ban accounts for violations or permanently delete organizer and volunteer accounts when required.
        Deleting a user removes the account and related profile, posts, support requests, registrations, notifications, ratings,
        and events created by that user. Admin accounts are protected for system safety.
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Organization</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                @foreach (var item in Model)
                {
                    var isAdmin = string.Equals(item.RoleName, "Admin", StringComparison.OrdinalIgnoreCase);
                    var displayVerified = isAdmin || item.IsVerified;
                    var isBanned = bannedStatus.ContainsKey(item.UserId) && bannedStatus[item.UserId];

                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrWhiteSpace(item.ProfileImageUrl))
                                {
                                    <img src="@item.ProfileImageUrl"
                                         class="rounded-circle"
                                         style="width:45px;height:45px;object-fit:cover;"
                                         alt="Profile" />
                                }
                                else
                                {
                                    <div class="bg-light rounded-circle d-flex align-items-center justify-content-center"
                                         style="width:45px;height:45px;">
                                        <span class="fw-bold text-primary">
                                            @(string.IsNullOrWhiteSpace(item.FullName) ? "U" : item.FullName.Substring(0, 1).ToUpper())
                                        </span>
                                    </div>
                                }

                                <div>
                                    <div class="fw-bold">@item.FullName</div>
                                    <small class="text-muted">@(item.PublicEmail ?? item.UserId)</small>
                                </div>
                            </div>
                        </td>

                        <td>
                            <span class="badge @(isAdmin ? "bg-dark" : item.RoleName == "Organizer" ? "bg-primary" : "bg-secondary") rounded-pill">
                                @item.RoleName
                            </span>
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(item.OrganizationName) ? "-" : item.OrganizationName)
                        </td>

                        <td>
                            @if (isBanned)
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill">
                                    <i class="bi bi-slash-circle me-1"></i> Banned
                                </span>
                            }
                            else if (displayVerified)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill">
                                    <i class="bi bi-patch-check-fill me-1"></i> Verified
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill">
                                    <i class="bi bi-hourglass-split me-1"></i> Pending
                                </span>
                            }
                        </td>

                        <td class="text-end">
                            <div class="d-inline-flex gap-2 flex-wrap justify-content-end">
                                @if (!isAdmin)
                                {
                                    @if (!isBanned)
                                    {
                                        @if (!item.IsVerified)
                                        {
                                            <form asp-action="Verify" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="isVerified" value="true" />
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">
                                                    Verify
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3" disabled>
                                                Verified
                                            </button>
                                        }

                                        <form asp-action="BanUser" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-warning rounded-pill px-3"
                                                    onclick="return confirm('Are you sure you want to ban this user account? This user will not be able to login.');">
                                                <i class="bi bi-slash-circle me-1"></i> Ban
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" disabled>
                                            Banned
                                        </button>

                                        <form asp-action="UnbanUser" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success rounded-pill px-3"
                                                    onclick="return confirm('Are you sure you want to unban this user account?');">
                                                <i class="bi bi-unlock me-1"></i> Unban
                                            </button>
                                        </form>
                                    }

                                    <form asp-action="DeleteUser" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                onclick="return confirm('Are you sure you want to permanently delete this user account and all related data?');">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" disabled>
                                        Protected
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>