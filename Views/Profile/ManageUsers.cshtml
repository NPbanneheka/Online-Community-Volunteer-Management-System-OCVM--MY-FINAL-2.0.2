@* ================================================================
   VIVA COMMENTED VERSION - Views/Profile/ManageUsers.cshtml
   Purpose: Razor View file: builds the HTML page shown to the user and displays data supplied by the controller.
   Note: Razor comments do not display to users; they help you explain the page in viva.
   ================================================================ *@

@using System
@model IEnumerable<OCVMS.Models.UserProfile>
@{
    ViewData["Title"] = "User Management";
    var lockoutMap = ViewBag.LockoutMap as Dictionary<string, DateTimeOffset?> ?? new Dictionary<string, DateTimeOffset?>();
    var currentAdminUserId = ViewBag.CurrentAdminUserId as string;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">User Management</h2>
            <p class="text-muted mb-0">Admin can verify, unverify, temporarily ban, unban, or delete any eligible user account.</p>
        </div>
    </div>

    <div class="alert alert-info rounded-4 border-0">
        <i class="bi bi-info-circle me-2"></i>
        New user accounts appear as <strong>Pending Verification</strong>. After verification, the status becomes <strong>Verified</strong> and the button changes to <strong>Unverify</strong>. Temporary ban changes the action to <strong>Unban</strong>. Delete permanently removes the user and related data. Admin accounts are protected system accounts.
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        @* Table: displays multiple records in a readable admin/user list. *@
<table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>Organization</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @* Loop: repeats this UI block for each item sent by the controller. *@
@foreach (var item in Model)
            {
                var isAdmin = string.Equals(item.RoleName, "Admin", StringComparison.OrdinalIgnoreCase);
                var isCurrentAdmin = string.Equals(item.UserId, currentAdminUserId, StringComparison.OrdinalIgnoreCase);
                var isProtectedAccount = isAdmin || isCurrentAdmin;
                var isTempBanned = lockoutMap.TryGetValue(item.UserId, out var lockoutEnd) && lockoutEnd.HasValue && lockoutEnd.Value > DateTimeOffset.UtcNow;
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            @* Conditional UI: shows/hides content based on role, status, or available data. *@
@if (!string.IsNullOrWhiteSpace(item.ProfileImageUrl))
                            {
                                <img src="@item.ProfileImageUrl" class="rounded-circle" style="width:45px;height:45px;object-fit:cover;" alt="Profile" />
                            }
                            else
                            {
                                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width:45px;height:45px;">
                                    <span class="fw-bold text-primary">@(string.IsNullOrWhiteSpace(item.FullName) ? "U" : item.FullName.Substring(0,1).ToUpper())</span>
                                </div>
                            }
                            <div>
                                <div class="fw-bold">@item.FullName</div>
                                <small class="text-muted">@(item.PublicEmail ?? item.UserId)</small>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="badge @(isAdmin ? "bg-dark" : item.RoleName == "Organizer" ? "bg-primary" : "bg-secondary") rounded-pill">
                            @item.RoleName
                        </span>
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(item.OrganizationName) ? "-" : item.OrganizationName)</td>
                    <td>
                        @if (isAdmin)
                        {
                            <span class="badge bg-dark bg-opacity-10 text-dark rounded-pill w-auto">
                                <i class="bi bi-shield-lock-fill me-1"></i> System Admin
                            </span>
                        }
                        else if (isTempBanned)
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill w-auto">
                                <i class="bi bi-slash-circle me-1"></i> Temporarily Banned
                            </span>
                        }
                        else if (item.IsVerified)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill w-auto">
                                <i class="bi bi-patch-check-fill me-1"></i> Verified
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill w-auto">
                                <i class="bi bi-hourglass-split me-1"></i> Pending Verification
                            </span>
                        }
                    </td>
                    <td class="text-end">
                        <div class="d-inline-flex flex-wrap gap-2 justify-content-end">
                            @if (isProtectedAccount)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" disabled>Protected</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" disabled>Protected</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" disabled>Protected</button>
                            }
                            else
                            {
                                @if (item.IsVerified)
                                {
                                    @* Form area: collects user input and sends it to the controller action. *@
<form asp-action="UnverifyUser" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        @* Input field: binds form data to the model/view model. *@
<input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-3"
                                                onclick="return confirm('Change this verified account back to pending verification?');">
                                            Unverify
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="VerifyUser" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3"
                                                onclick="return confirm('Verify this user account?');">
                                            Verify
                                        </button>
                                    </form>
                                }

                                @if (isTempBanned)
                                {
                                    <form asp-action="UnbanUser" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3"
                                                onclick="return confirm('Unban this account so the user can log in again?');">
                                            Unban
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="TempBanUser" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                onclick="return confirm('Temporarily ban this account from logging in?');">
                                            Temp Ban
                                        </button>
                                    </form>
                                }

                                <form asp-action="DeleteUser" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                            onclick="return confirm('Are you sure you want to permanently delete this user account and all related data?');">
                                        <i class="bi bi-trash me-1"></i> Delete
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
