@model IEnumerable<OCVMS.Models.UserProfile>
@{
    ViewData["Title"] = "User Verification";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">User Verification</h2>
            <p class="text-muted mb-0">Admin can verify or mark users as pending after checking profile and organization details.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th>User</th><th>Role</th><th>Organization</th><th>Status</th><th class="text-end">Action</th></tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            @if (!string.IsNullOrWhiteSpace(item.ProfileImageUrl))
                            {
                                <img src="@item.ProfileImageUrl" class="rounded-circle" style="width:45px;height:45px;object-fit:cover;" alt="Profile" />
                            }
                            else
                            {
                                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width:45px;height:45px;"><span class="fw-bold text-primary">@item.FullName.Substring(0,1).ToUpper()</span></div>
                            }
                            <div>
                                <div class="fw-bold">@item.FullName</div>
                                <small class="text-muted">@(item.PublicEmail ?? item.UserId)</small>
                            </div>
                        </div>
                    </td>
                    <td>@item.RoleName</td>
                    <td>@(string.IsNullOrWhiteSpace(item.OrganizationName) ? "-" : item.OrganizationName)</td>
                    <td>
                        @if (item.IsVerified)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill">Verified</span>
                        }
                        else
                        {
                            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill">Pending</span>
                        }
                    </td>
                    <td class="text-end">
                        <form asp-action="Verify" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="isVerified" value="@(!item.IsVerified)" />
                            <button type="submit" class="btn btn-sm @(item.IsVerified ? "btn-outline-warning" : "btn-success") rounded-pill px-3">
                                @(item.IsVerified ? "Mark Pending" : "Verify")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
