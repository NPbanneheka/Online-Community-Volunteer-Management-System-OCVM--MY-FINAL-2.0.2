@* 
View responsibility: Views/Profile/ViewProfile.cshtml
Technology map:
- Razor syntax mixes HTML with C# expressions for dynamic page rendering.
- Tag Helpers such as asp-action/asp-controller connect forms and links to MVC controller actions.
- Model/ViewBag data comes from the controller action that returns this view.
*@

@model UserProfile
@{ ViewData["Title"] = "Profile"; }
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-modern p-5 text-center">
            @* Conditional UI: shows/hides content based on role, status, or available data. *@
@if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl))
            {
                <img src="@Model.ProfileImageUrl" class="rounded-circle shadow mx-auto mb-3" style="width:130px;height:130px;object-fit:cover;" alt="Profile" />
            }
            else
            {
                <div class="profile-avatar mx-auto mb-3">@Model.FullName.Substring(0,1).ToUpper()</div>
            }
            <h2 class="fw-bold mb-1">@Model.FullName</h2>
            <div class="text-muted mb-2">@Model.RoleName</div>
            @if (Model.IsVerified)
            {
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill mb-3"><i class="bi bi-patch-check-fill me-1"></i> Verified</span>
            }
            else
            {
                <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill mb-3"><i class="bi bi-hourglass-split me-1"></i> Pending Verification</span>
            }
            <div class="mb-3">Average Rating: <strong>@(((double)ViewBag.AverageRating).ToString("0.0"))</strong></div>
            <p class="text-muted mb-0">@Model.Bio</p>
        </div>
    </div>
</div>
